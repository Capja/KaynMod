<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Esencia de Kayn: Salud limpia, Habilidades a 20 y Estadísticas Divinas -->
  <HediffDef>
    <defName>Kayn_Awakened</defName>
    <label>Esencia de Kayn</label>
    <description>Contiene el poder primordial de Kayn. Otorga maestría absoluta en cualquier disciplina física o intelectual, regeneración celular constante y la capacidad de desatar su fuerza sobrehumana.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.2, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.1</initialSeverity>
    <stages>

      <!-- ================= FASE 0: MODO NORMAL ================= -->
      <li>
        <label>Modo Normal</label>
        <becomeVisible>true</becomeVisible>
        <statOffsets>
          <PsychicEntropyRecoveryRate>1000</PsychicEntropyRecoveryRate>
          <PsychicEntropyMax>500</PsychicEntropyMax>
          <PsychicSensitivity>2.0</PsychicSensitivity>
          <ResearchSpeed>2.0</ResearchSpeed>             <!-- +200% Investigación -->
          <MiningSpeed>2.0</MiningSpeed>                 <!-- +200% Minería base -->
          <MentalBreakThreshold>-0.2</MentalBreakThreshold> <!-- Mente muy estable -->
        </statOffsets>
      </li>

      <!-- ================= FASE 1: MODO SERIO ================= -->
      <li>
        <minSeverity>1.0</minSeverity>
        <label>Modo Serio</label>
        <becomeVisible>true</becomeVisible>
        <painFactor>0.1</painFactor> <!-- Prácticamente insensible al dolor -->

        <!-- Inmunidad a ataques psíquicos hostiles -->
        <makeImmuneTo>
          <li>PsychicShock</li>        <!-- Inmune a Lanza de Choque Psíquico -->
          <li>PsychicSuppression</li>  <!-- Inmune a la máquina mecanoide de supresión -->
        </makeImmuneTo>

        <!-- Capacidades de la pestaña Salud -->
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>5.0</offset>        <!-- +500% Movimiento -->
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>5.0</offset>        <!-- +500% Manipulación -->
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>5.0</offset>        <!-- +500% Vista -->
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>5.0</offset>        <!-- +500% Consciencia -->
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>5.0</offset>        <!-- +500% Oído -->
          </li>
        </capMods>

        <!-- Estadísticas físicas, de trabajo y combate -->
        <statOffsets>
          <!-- Resistencia: Las balas y filos normales rebotan -->
          <ArmorRating_Sharp>1.5</ArmorRating_Sharp>      <!-- 150% Armadura punzante -->
          <ArmorRating_Blunt>1.5</ArmorRating_Blunt>      <!-- 150% Armadura contundente -->
          <ArmorRating_Heat>1.2</ArmorRating_Heat>       <!-- 120% Armadura térmica -->

          <!-- Inquebrantable mentalmente -->
          <MentalBreakThreshold>-0.5</MentalBreakThreshold>

          <PsychicEntropyRecoveryRate>1000</PsychicEntropyRecoveryRate>
          <PsychicEntropyMax>500</PsychicEntropyMax>
          <PsychicSensitivity>2.0</PsychicSensitivity>
          <WorkSpeedGlobal>5.0</WorkSpeedGlobal>          <!-- +500% Trabajo general -->
          <ResearchSpeed>5.0</ResearchSpeed>             <!-- +500% Investigación -->
          <MiningSpeed>6.0</MiningSpeed>                 <!-- Pica roca con enorme facilidad -->
          <CarryingCapacity>500</CarryingCapacity>         <!-- +500 kg de carga -->
          <MeleeDodgeChance>50</MeleeDodgeChance>          <!-- Gran evasión CaC -->
          <ShootingAccuracyPawn>20</ShootingAccuracyPawn>  <!-- Puntería letal -->
          <ComfyTemperatureMin>-50</ComfyTemperatureMin>   <!-- Resistencia al frío -->
          <ComfyTemperatureMax>50</ComfyTemperatureMax>    <!-- Resistencia al calor -->
        </statOffsets>

        <statFactors>
          <!-- Traspaso y aniquilación -->
          <MeleeDamageFactor>10.0</MeleeDamageFactor>              <!-- x10 daño cuerpo a cuerpo -->
          <MeleeArmorPenetrationFactor>5.0</MeleeArmorPenetrationFactor> <!-- Atraviesa cualquier armadura común -->
          <IncomingDamageFactor>0.2</IncomingDamageFactor>        <!-- Reduce el 80% del daño -->
          <StaggerDurationFactor>0</StaggerDurationFactor>        <!-- Sin frenado por balas -->

          <!-- Calidad de vida solo / supervivencia -->
          <RestFallRateFactor>0.3</RestFallRateFactor>           <!-- Duerme poquísimo -->
          <HungerRateFactor>0.5</HungerRateFactor>               <!-- Rara vez tiene hambre -->

          <MeleeCooldownFactor>0.3</MeleeCooldownFactor>          <!-- Golpea el triple de rápido -->
          <AimingDelayFactor>0.3</AimingDelayFactor>
          <RangedCooldownFactor>0.3</RangedCooldownFactor>
        </statFactors>
      </li>

      <!-- ================= FASE 2: MODO MORTALMENTE SERIO ================= -->
      <li>
        <minSeverity>2.0</minSeverity>
        <label>Modo Mortalmente Serio</label>
        <becomeVisible>true</becomeVisible>
        <painFactor>0</painFactor> <!-- Inmunidad absoluta al dolor: Imposible noquearlo -->

        <!-- Inmunidad a ataques psíquicos hostiles -->
        <makeImmuneTo>
          <li>PsychicShock</li>        <!-- Inmune a Lanza de Choque Psíquico -->
          <li>PsychicSuppression</li>  <!-- Inmune a la máquina mecanoide de supresión -->
        </makeImmuneTo>

        <!-- Capacidades de la pestaña Salud -->
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>10.0</offset>       <!-- +1000% Movimiento -->
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>10.0</offset>       <!-- +1000% Manipulación -->
          </li>
          <li>
            <capacity>Sight</capacity>
            <offset>10.0</offset>        <!-- +1000% Vista -->
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>10.0</offset>        <!-- Consciencia divina -->
          </li>
          <li>
            <capacity>Hearing</capacity>
            <offset>10.0</offset>        <!-- +1000% Oído -->
          </li>
        </capMods>

        <!-- Estadísticas divinas -->
        <statOffsets>
          <!-- Piel invulnerable (Estilo Saitama) -->
          <ArmorRating_Sharp>3.0</ArmorRating_Sharp>      <!-- 300% Armadura punzante (Balas/rifles rebotan) -->
          <ArmorRating_Blunt>3.0</ArmorRating_Blunt>      <!-- 300% Armadura contundente (Inmune a porrazos) -->
          <ArmorRating_Heat>2.5</ArmorRating_Heat>       <!-- 250% Inmune a quemaduras y láseres -->

          <!-- Cero colapsos mentales: Jamás romperá su propia base -->
          <MentalBreakThreshold>-1.0</MentalBreakThreshold>

          <PsychicEntropyRecoveryRate>1000</PsychicEntropyRecoveryRate>
          <PsychicEntropyMax>500</PsychicEntropyMax>
          <PsychicSensitivity>2.0</PsychicSensitivity>
          <WorkSpeedGlobal>10.0</WorkSpeedGlobal>          <!-- +1000% Trabajo -->
          <ResearchSpeed>20.0</ResearchSpeed>            <!-- +2000% Investigación instantánea -->
          <MiningSpeed>25.0</MiningSpeed>                <!-- Desintegra montañas de un golpe -->
          <CarryingCapacity>1000</CarryingCapacity>        <!-- +1000 kg de carga -->
          <MeleeDodgeChance>100</MeleeDodgeChance>         <!-- Intocable en cuerpo a cuerpo -->
          <ShootingAccuracyPawn>80</ShootingAccuracyPawn>  <!-- Disparo infalible -->
          <ToxicResistance>1.0</ToxicResistance>           <!-- Inmune a toxinas, polución y gas -->
          <ComfyTemperatureMin>-150</ComfyTemperatureMin> <!-- Sobrevive al espacio exterior -->
          <ComfyTemperatureMax>150</ComfyTemperatureMax>  <!-- Sobrevive dentro de hornos/volcanes -->
        </statOffsets>

        <statFactors>
          <!-- Aniquilación absoluta -->
          <MeleeDamageFactor>30.0</MeleeDamageFactor>             <!-- Un impacto pulveriza peones -->
          <MeleeArmorPenetrationFactor>20.0</MeleeArmorPenetrationFactor> <!-- Ignora armaduras de Mechs o Cataphractas -->
          <IncomingDamageFactor>0.01</IncomingDamageFactor>       <!-- Anula el 99% del daño remanente -->
          <StaggerDurationFactor>0</StaggerDurationFactor>        <!-- Jamás se frena por disparos -->

          <!-- Prácticamente no necesita comer ni dormir -->
          <RestFallRateFactor>0.05</RestFallRateFactor>
          <HungerRateFactor>0.1</HungerRateFactor>

          <MeleeCooldownFactor>0.15</MeleeCooldownFactor>
          <AimingDelayFactor>0.1</AimingDelayFactor>
          <RangedCooldownFactor>0.15</RangedCooldownFactor>
          <Flammability>0</Flammability>                          <!-- Incombustible -->
        </statFactors>
      </li>

    </stages>
    <comps>
      <!-- Regeneración pasiva automática de heridas -->
      <li Class="KaynMod.HediffCompProperties_KaynRegeneration" />
      <!-- Batería psíquica: Psicofoco 100%, Calor 0, Psylink 6 y puntos VPE -->
      <li Class="KaynMod.HediffCompProperties_KaynPsycastBattery" />
      <!-- Maestría absoluta: Todas las habilidades a 20 fijas -->
      <li Class="KaynMod.HediffCompProperties_KaynMastery" />
      <!-- Inmunidad biológica universal a cualquier enfermedad (Vanilla + Mods) -->
      <li Class="KaynMod.HediffCompProperties_KaynImmunity" />
    </comps>
  </HediffDef>

  <!-- Velo de Sombras (Invisibilidad) -->
  <HediffDef>
    <defName>Kayn_Invisibility</defName>
    <label>Velo de Sombras</label>
    <description>Oculta al ser de la percepción física y psicológica de los demás.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.4, 0.6, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Invisibility">
        <compClass>HediffComp_Invisibility</compClass>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
  </HediffDef>

  <!-- Hediff de Sueño / Letargo Temporal -->
  <HediffDef>
    <defName>Kayn_Slumber</defName>
    <label>Letargo Umbrío</label>
    <description>Un trance de sueño profundo inducido por las sombras. La consciencia se desvanece de inmediato, haciendo que el ser caiga dormido pacíficamente sin sufrir secuelas ni daño biológico.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.4, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <comps>
      <!-- Desaparece automáticamente después de un rato (~45 segundos reales / unas horas de juego) -->
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~4000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>en trance</label>
        <!-- Limitar la consciencia al 10% hace que caiga desplomado dormido en el acto -->
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.10</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>